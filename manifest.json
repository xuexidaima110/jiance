{
  "manifest_version": 3,
  "name": "即梦视频任务监控器",
  "version": "1.1.0",
  "description": "监控即梦AI视频生成任务，保持最大10个并发，自动提交备用任务",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting",
    "webRequest"
  ],
  "host_permissions": [
    "https://jimeng.jianying.com/*",
    "https://*.jimeng.jianying.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://jimeng.jianying.com/*", "https://*.jianying.com/*", "https://*.bytedance.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "即梦任务监控器"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["interceptor.js"],
      "matches": ["https://jimeng.jianying.com/*"]
    }
  ]
}